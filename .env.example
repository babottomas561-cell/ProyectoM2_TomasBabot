# Copiar este archivo como .env y completar. El .env NO se sube al repo.

# PostgreSQL local (en Mac con Homebrew suele alcanzar con el usuario del sistema y sin contraseña)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fleetlogix
PGUSER=tu_usuario
PGPASSWORD=

# Snowflake (Avance 3). La cuenta tiene el formato ORGANIZACION-CUENTA (ej: abcdefg-xy12345)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=    # LOGIN_NAME del usuario (si entrás con Google, es tu mail en mayúsculas)
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=FLEETLOGIX_WH
SNOWFLAKE_DATABASE=FLEETLOGIX_DW
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Opcional: conexión con par de llaves en lugar de contraseña
SNOWFLAKE_PRIVATE_KEY_FILE=keys/snowflake_rsa_key.p8
